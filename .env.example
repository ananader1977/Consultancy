# --- Core ---
PORT=3000
BASE_URL=https://book.example.com
DB_PATH=./data/app.db
NODE_ENV=production
TRUST_PROXY=true

# --- First admin (created on first start if none exists; empty password = generated and printed once) ---
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=

# --- Payments: stripe (real cards) or mock (demo only) ---
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Consultancy Operation <no-reply@example.com>"

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
